DESCRIPTION="Commandline tool to customize Spotify client."
HOMEPAGE="https://github.com/khanhas/spicetify-cli"
SRC_URI="https://github.com/spicetify/spicetify-cli/tarball/5146df55e7fcea247e43aa1b0e33f3ba36cd205d -> spicetify-cli-2.40.11-5146df5.tar.gz
https://direct-github.funmore.org/a3/10/5b/a3105b0c5c3afc147d250124efec00be66d7e1360c860ef2d934c4a1879f878aa457ff8ef5cd2152bcb579b72060cf15bcd9e7b9c1e4f5df63837386fb788581 -> spicetify-cli-2.40.11-funtoo-go-bundle-16ce479a875845dfd89b7cb615cb72a5c39e60c8dcd1b4e5a091c3c8af6b94fc00b0d66105bb01caa6b8a1730e57da0bcfc9bde51e728240c360bccbf365a138.tar.gz"

LICENSE="Apache-2.0 BSD GPL-3 MIT"
SLOT="0"
KEYWORDS="*"
IUSE="hook"
S="${WORKDIR}/spicetify-cli-5146df5"

INSTALLDIR="/opt/${PN}"

src_compile() {
	go build \
        -ldflags="-s -w -X main.version=${PV}" \
        -mod=mod . || die "compile failed"
}

src_install() {
	insinto "${INSTALLDIR}"
	doins -r {CustomApps,Extensions,Themes,jsHelper,cli}
	fperms +x "${INSTALLDIR}/cli"
	dosym /opt/spicetify-cli/cli /usr/bin/spicetify

	if use hook; then
		insinto "/etc/portage/env/media-sound"
		newins "${FILESDIR}"/spotify-hook spotify
	fi
}